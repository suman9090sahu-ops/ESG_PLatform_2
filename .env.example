# MEIL ESG CONTROL TOWER - Environment Configuration

# Django Settings Module
DJANGO_SETTINGS_MODULE=config.settings.development

# Security
DJANGO_SECRET_KEY=django-insecure-meil-esg-control-tower-phase00-development-key-change-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# In development, if DATABASE_URL is not set or empty, falls back gracefully to SQLite
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/meil_esg_db
DATABASE_URL=
# Or explicit PostgreSQL parameters:
# POSTGRES_DB=meil_esg_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Security (Production only)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Static and Media
STATIC_URL=/static/
MEDIA_URL=/media/
